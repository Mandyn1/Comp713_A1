<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Showings List</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th></th>
      <th>Movie Name</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (data && data.length > 0) { %>
      <% data.forEach((showing, index) => { %>
        <tr>
          <td><%= showing.showingDate %></td>
          <td>|</td>
          <td><%= showing.movie %></td>
          <td>|</td>
          <td><button type="button" onclick="handleBookClick('<%= showing.id %>')">Book</button>
          <button type="button" onclick="handleInfoClick('<%= showing.movieID %>')">Movie Info</button></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="4" style="text-align: center;">No Showings Available</td>
      </tr>
    <% } %>
  </tbody>
</table>
<button type="button" onclick="handleSignInClick()">Sign In</button>
<div id="signInOverlay" style="display: none; position: fixed;">
  <h2>Sign In</h2>
  <form id="signInForm" action="/api/signin" method="POST">
    <label for="username">Username:</label>
    <input type="text" id="username" name="username" required>
    <br>
    <label for="password">Password:</label>
    <input type="password" id="password" name="password" required>
    <br>
    <button type="button">Submit</button>
  </form>
  <button type="button" onclick="handleSignInClick()">Close</button>
</div>
<button type="button" onclick="handleResetClick()">Reset Database</button>
</html>

<script>
  function handleBookClick(id) {
    window.location.href = "/api/showings/" + id;
  }

  function handleInfoClick(id) {
    window.location.href = "/api/movies/" + id + "-from-" + 0;
  }

  function handleResetClick() {
    fetch('/api/server/datareload')
    .then((response) =>{
      response.json()
      .then(data => {
        alert(data.message);
        window.location.href = '/api/showings';
      });
    });
  }

  function handleSignInClick() {
    if (signInOverlay.style.display == 'none') signInOverlay.style.display = 'block';
    else signInOverlay.style.display = 'none';
  }
</script>