<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Showings List</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th></th>
      <th>Movie Name</th>
      <th></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if (data && data.length > 0) { %>
      <% data.forEach((showing, index) => { %>
        <tr>
          <td><%= showing.showingDate %></td>
          <td>|</td>
          <td><%= showing.movie %></td>
          <td>|</td>
          <td><button type="button" onclick="handleClick('<%= showing.id %>')">Book</button></td>
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="4" style="text-align: center;">No Showings Available</td>
      </tr>
    <% } %>
  </tbody>
</table>
<button type="button" onclick="handleResetClick()">Reset Database</button>
</html>

<script>
  function handleClick(id) {
    window.location.href = "/api/showings/" + id;
  }

  function handleResetClick() {
    fetch('/api/datareload')
    .then((response) =>{
      response.json()
      .then(data => {
        alert(data.message);
        window.location.href = '/api/showings';
      });
    });
  }
</script>