<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= showingData.name %> Showing</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1><%= showingData.name %> || <button type="button" onclick="handleMovieClick('<%= showingData.movie %>')">Movie Info</button></h1>
    <h2><%= showingData.showingDate %></h2>

</body>
<table>
    <% if (seatingData && seatingData.array.length > 0) { %>
        <thead>
            <tr>
                <th></th>
                <% for(let i = 1; i <= seatingData.colCount; i++) { %>
                    <th><%= i %></th>
                <% }; %>
            
            </tr>
        </thead>
        <tbody>
            <% for(let i = 0; i < seatingData.rowCount; i++) { %>
                <tr>
                    <th><%= seatingData.array[i][0].seatRow %></th>
                    <% const temp = sessionStorage.getItem('reservedTickets'); %>
                    <% const tempList = temp ? JSON.parse(temp) : []; %>
                    <% for(let j = 0; j < seatingData.colCount; j++) { %>
                        <% if(tempList.includes(seatingData.array[i][j].id)) { %>
                            <td><button type="button" onclick="handleSeatUnreserveClick('<%= showingData.id %>', '<%= seatingData.array[i][j].id %>', '<%= seatingData.array[i][j].available %>')">Unreserve</button></td>
                        <% } else if(seatingData.array[i][j].available == true) { %>
                            <td><button type="button" onclick="handleSeatReserveClick('<%= showingData.id %>', '<%= seatingData.array[i][j].id %>')">Reserve</button></td>
                        <% }  else { %>
                            <td><button type="button" onclick="">Taken</button></td>
                        <% }; %>
                    <% }; %>
                </tr>
            <% }; %>
        </tbody>
    <% } else { %>
        <tr>
            <td colspan="4" style="text-align: center;">Unable to load Seating Grid</td>
        </tr>
    <% } %>
</table>
<div id="timerBox" style="display: none;">
    Update Timer: <span id="timerText">00</span>
</div>
</html>

<script>

    function handleMovieClick(movieID) {
        window.location.href = "/api/movies/" + movieID;
    }

    async function handleSeatReserveClick(showingID, seatID){

        const response = await fetch("/api/showings/" + showingID + "/reserve=" + seatID);
        const data = await response.json();

        addReservedList(data.message);
        
        alert("Seat Reserved!");

        fetch('/api/showings/' + showingID);
    }

    async function handleSeatUnreserveClick(showingID, ticketID){
        if(getReservedList().includes(ticketID)){
            await fetch('/api/showings/release=' + ticketID);

            alert("Seat Unreserved!");

            fetch('/api/showings/' + showingID);
        }
    }

    function getReservedList(){
        const data = sessionStorage.getItem('reservedTickets');
        const list = data ? JSON.parse(data) : []

        return list;
    }

    function addReservedList(ticketID){
        let list = getReservedList();

        list.push(ticketID);

        sessionStorage.setItem('reservedTickets', JSON.stringify(list));
    }

    let timerInterval = 1000; // ms
    let timerRemaining = 10;

    function delay (time) {
    return new Promise((resolve) => setTimeout(resolve, time));
    };

    //Timer to reload page and check for external ticketing updates
    async function timer(showingID){
        
        timerBox.style.display = 'block'; 

        while (true){
            await delay(timerInterval);
            timerRemaining--;
            timerText.textContent = timerRemaining; 

            if(timerRemaining <= 0){
                fetch('/api/showings/' + showingID);
            }
        } 
    }

</script>