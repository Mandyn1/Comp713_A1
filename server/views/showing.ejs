<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= showingData.name %> Showing</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1><%= showingData.name %> || <button type="button" onclick="handleMovieClick('<%= showingData.movie %>')">Movie Info</button></h1>
    <h2><%= showingData.showingDate %></h2>

</body>
<table>
    <% if (seatingData && seatingData.array.length > 0) { %>
        <thead>
            <tr>
                <th></th>
                <% for(let i = 1; i <= seatingData.colCount; i++) { %>
                    <th><%= i %></th>
                <% }; %>
            
            </tr>
        </thead>
        <tbody>
            <% for(let i = 0; i < seatingData.rowCount; i++) { %>
                <tr>
                    <th><%= seatingData.array[i][0].seatRow %></th>

                    <% for(let j = 0; j < seatingData.colCount; j++) { %>
                        <% if(seatingData.array[i][j].available == true) { %>
                            <td><button type="button" onclick="handleSeatClick('<%= showingData.id %>', '<%= seatingData.array[i][j].id %>', '<%= seatingData.array[i][j].available %>')">Book</button></td>
                        <% }  else { %>
                            <td><button type="button" onclick="">Taken</button></td>
                        <% }; %>
                    <% }; %>
                </tr>
            <% }; %>
        </tbody>
    <% } else { %>
        <tr>
            <td colspan="4" style="text-align: center;">Unable to load Seating Grid</td>
        </tr>
    <% } %>
</table>
<div id="timerBox" style="display: none;">
    Reserve Timer: <span id="timerText">00</span>
</div>
</html>

<script>

    function handleMovieClick(movieID) {
        window.location.href = "/api/movies/" + movieID;
    }

    async function handleSeatClick(showingID, seatID, seatAvailable){
        if(seatAvailable){
            const response = await fetch("/api/showings/" + showingID + "/reserve=" + seatID);
            const data = await response.json();

            addReservedList(data.message);
            if(!timerRunning) timer();
            
            alert("Seat Reserved!");
        }
        else alert("Seat is unavailable!");
    }

    async function handleConfirmClick(){

        const list = getReservedList();
        let counter = list.length;

        list.forEach(async element => {
            if(await fetch('/api/showings/confirm=' + element)) counter--;

        });

        if(counter == 0){
            alert("Tickets Confirmed: " + list.join(', '));
        }
        else{
            alert("An Error has occured. Please reselect tickets!");
        }

        clearReservedList();
    }

    function getReservedList(){
        const data = sessionStorage.getItem('reservedTickets');
        const list = data ? JSON.parse(data) : []

        return list;
    }

    function addReservedList(ticketID){
        let list = getReservedList();

        list.push(ticketID);

        sessionStorage.setItem('reservedTickets', JSON.stringify(list));
    }

    async function clearReservedList(){
        const list = getReservedList();

        for (const element of list){
            await fetch('/api/showings/release=' + element);
        };

        sessionStorage.removeItem('reservedTickets');
    }

    let timerRunning = false;
    let timerInterval = 1000; // ms
    let timerRemaining = 60;

    function delay (time) {
    return new Promise((resolve) => setTimeout(resolve, time));
    };

    //Recursive timer that runs if non-confirmed tickets exist
    async function timer(){

        timerRemaining = 60;
        timerRunning = true;
        
        const timerBox = document.getElementById('timerBox');
        const timerText = document.getElementById('timerText');
        
        // Show the container
        timerBox.style.display = 'block'; 

        while(timerRunning){
            await delay(timerInterval);
            timerRemaining--;
            // Inject your countdown text
            timerText.textContent = timerRemaining; 

            if(timerRemaining <= 0){
                await clearReservedList();
                timerRunning = false;
                timerBox.style.display = 'none'; 
                alert("Reserve Time Expired, Please Reselect Tickets");
            }
        }
    }

</script>