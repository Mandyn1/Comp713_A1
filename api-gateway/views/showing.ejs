<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= showingData.name %> Showing</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1><%= showingData.name %> || 
        <button type="button" onclick="handleMovieClick()">Movie Info</button>
        <button type="button" onclick="handleListClick()">Showing List</button>
    </h1>
    <h2><%= showingData.showingDate %></h2>

</body>
<table>
    <% if (seatingData && seatingData.array.length > 0) { %>
        <thead>
            <tr>
                <th></th>
                <% for(let i = 1; i <= seatingData.colCount; i++) { %>
                    <th><%= i %></th>
                <% }; %>
            
            </tr>
        </thead>
        <tbody>
            <% for(let i = 0; i < seatingData.rowCount; i++) { %>
                <tr>
                    <th><%= seatingData.array[i][0].seatRow %></th>
                    <% for(let j = 0; j < seatingData.colCount; j++) { %>
                        <td><button class="reserveButton" 
                            seatID="<%= seatingData.array[i][j].id %>"
                            available="<%= seatingData.array[i][j].available %>"
                            >Taken</button></td>
                    <% }; %>
                </tr>
            <% }; %>
        </tbody>
    <% } else { %>
        <tr>
            <td colspan="4" style="text-align: center;">Unable to load Seating Grid</td>
        </tr>
    <% } %>
</table>
<div id="timerBox" style="display: none;">
    Update Timer: <span id="timerText">10</span>
</div>
<h1><button type="button" onclick="handlePauseTimerClick()">Pause Timer</button></h1>
</html>

<script>
    const showingID = "<%= showingData.id %>";
    const movieID = '<%= showingData.movieID %>';


    const buttonList = document.querySelectorAll('.reserveButton');

    buttonList.forEach(button => {
        const seatID = button.getAttribute('seatID');
        const available = button.getAttribute('available');

        if(available == 'true'){
            button.textContent = "Reserve";
            button.onclick = () => handleSeatReserveClick(seatID);
        }
        else if (sessionStorage.getItem(seatID) !== null){
            button.textContent = "Unreserve";
            button.onclick = () => handleSeatUnreserveClick(seatID);
        }
    });

    function handleMovieClick() {
        window.location.href = "/api/movies/" + movieID + "-from-" + showingID;
    }

    function handleListClick() {
        window.location.href = "/api/showings";
    }

    async function handleSeatReserveClick(seatID){

        const response = await fetch("/api/tickets/reserve/" + seatID + "-in=" + showingID);
        const data = await response.json();

        sessionStorage.setItem(seatID,data.message);
        
        alert("Seat Reserved!");

        location.reload();
    }

    async function handleSeatUnreserveClick(seatID){
        await fetch('/api/tickets/release/' + sessionStorage.getItem(seatID));
        sessionStorage.removeItem(seatID);

        alert("Seat Unreserved!");

        location.reload();
    }

    let timerInterval = 1000; // ms
    let timerRemaining = 10;
    let timerRunning = true;

    function delay (time) {
    return new Promise((resolve) => setTimeout(resolve, time));
    };

    //Timer to reload page and check for external ticketing updates
    async function timer(){
        
        timerBox.style.display = 'block'; 

        while (timerRunning){
            await delay(timerInterval);
            timerRemaining--;
            timerText.textContent = timerRemaining; 

            if(timerRemaining <= 0){
                location.reload();
                return;
            }
        } 
    }
    
    function handlePauseTimerClick(){
        timerRunning = false;
    }

    timer();

</script>